# Стиль форматирования.
#
# За основу взят LLVM: код с самого начала писался близко к нему. Изменены две
# вещи.
#
# ColumnLimit: 95 — подобрано по уже написанному коду. При 80 и 90 clang-format
#   переламывал заметно больше строк, чем переламывал бы человек; при 100 начинал
#   склеивать то, что разнесено осмысленно.
# QualifierAlignment: Left — const слева от типа. На нынешнем коде эта настройка
#   ничего не меняет, она держит строй на будущее: автоправки clang-tidy ставят
#   const справа (`pugi::xml_node const`), и без неё стиль расползётся.

BasedOnStyle: LLVM
ColumnLimit: 95
QualifierAlignment: Left
